# Copy to webapp/.env and fill in.
VTA_DOMAIN=volleyballtacticalanalyze.com
# Cloudflare Zero Trust -> Networks -> Tunnels -> Create tunnel -> copy the token
CLOUDFLARE_TUNNEL_TOKEN=
# Days to keep uploaded analyses before automatic deletion
VTA_RETENTION_DAYS=14
# Local (non-Docker) runs only:
# MONGODB_URI=mongodb://localhost:27017
# VTA_STORAGE_DIR=C:\vta_storage
