# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment (recreate on each machine - never commit)
.venv/
venv/
env/

# Large media - transfer separately, not via git
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Over GitHub's 100MB hard limit; duplicate exists at ALL_13_MODELS/ too
/ml_models_all/extra_trees.joblib
/ALL_13_MODELS/ML_models/extra_trees.joblib

# OS junk
.DS_Store
Thumbs.db

# Reproduction outputs: regenerated by `python reproduce.py`, so committing them
# would make the repo carry stale numbers that disagree with the code. The
# committed source of truth is the script; results/latest/ is a build artefact.
/results/
reproduce_full.log
reproduce_full2.log

# Extraction logs are build artefacts of run_shards.sh, regenerated on every
# run. The extracted CSVs themselves (training_csv*/) ARE committed - they are
# the training data and are small (~2-4 MB) - but their logs are not.
extract_shard_*.log
extract_v3.log

# Large archives and datasets - transfer separately
*.zip
dataset/
volleyball-detection.yolov11/

# Stock detector weights - auto-download via ultralytics, no reason to bloat
# the repo. The custom fine-tune (fyp/volleyball_best.pt) is NOT excluded here -
# it is a real trained deliverable and is un-ignored in fyp/.gitignore.
/yolo11n.pt
/yolov8n.pt

# Simulated gold labels are NOT data - they exist only to exercise the Tier-2
# code path and their numbers are meaningless.
gold_SIMULATED.csv

# Unidentified stray download artefact, not a project file.
zi5nYeAc
.git-old-keshav-backup/

# Regenerable caches/features (~2.4 GB)
/PAPER_OUTPUT/cache/
/PAPER_OUTPUT/features/

# Over GitHub 100MB limit
/ml_models_v5/extra_trees.joblib
/ml_models_v6/extra_trees.joblib

# Small demo videos for the README (screen recording of the web app)
!docs/assets/*.mp4
